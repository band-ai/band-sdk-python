# Required: one entry per agent; target URLs include the invocation path.
BAND_BRIDGE_AGENTS='[{"agent_id":"your-agent-uuid","api_key":"your-agent-key","target":{"type":"http","url":"https://agent.example.com/invocations","bearer_token":"your-bearer-token","timeout":300}}]'

# messages_only defaults to false so room cleanup events reach the receiver.
# Opt in per agent only when the receiver does not need those events.

# These must match the platform that issued the agent key.
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket
BAND_REST_URL=https://app.band.ai
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
