      "source": {
        "profile": "band-contract/file-source/1",
        "format": "frontmatter",
        "content": "---\nname: team-review\ndescription: Test team review with explicit roles and outcomes.\nengine: 0.2.0-lab.1\nroles: [lead, alpha, beta, reviewer]\n---\n\"\"\"\nCollect two independent submissions before review.\n\"\"\"\ncontract @4h mentions 3 => expired\n\n\"\"\"\nYou are the lead. State the goal once, then wait for both submissions and the reviewer's\napproval.\n\"\"\"\nrole lead\n\n\"\"\"\nYou are Alpha. Work on the goal on your own, without copying Beta, and submit within ten minutes.\n\"\"\"\nrole alpha\n\n\"\"\"\nYou are Beta. Work on the goal on your own, without copying Alpha, and submit within ten minutes.\n\"\"\"\nrole beta\n\n\"\"\"\nYou are the reviewer. Wait for both submissions, compare them against the goal, and approve\nwithin two minutes.\n\"\"\"\nrole reviewer\n\n\"\"\"\nThe goal for both members, with what a good submission must contain.\n\"\"\"\ntype start\n  goal: text(bytes: 1..9600, graphemes: 1..600)\n\n\"\"\"\nYour submission for the goal: the artifact itself or a reference to it.\n\"\"\"\ntype submit\n  artifact: text(bytes: 1..9600, graphemes: 1..600)\n\n\"\"\"\nApprove both submissions.\n\"\"\"\ntype approve\n\n\"\"\"\nThe lead has not stated the goal yet. Send start to both members and the reviewer.\n\"\"\"\nstate new\n  lead -> {alpha,beta,reviewer}: start() => collecting\n\n\"\"\"\nAlpha and Beta each owe one submission within ten minutes. Review starts when both have arrived.\n\"\"\"\nstate collecting\n  {alpha,beta} -> {lead,reviewer}: submit() each @10m => reviewing | stalled\n\n\"\"\"\nBoth submissions are in. The reviewer owes an approval within two minutes.\n\"\"\"\nstate reviewing\n  reviewer -> {lead,alpha,beta}: approve() @2m => complete | stalled\n\n\"\"\"\nThe reviewer approved both submissions. Send nothing more.\n\"\"\"\nend complete\n\n\"\"\"\nA submission or the approval did not arrive in time. Stop, and report what is missing to the\nlead.\n\"\"\"\nend stalled\n\n\"\"\"\nThe four-hour contract clock ran out. Send nothing more.\n\"\"\"\nend expired\n",
        "sha256": "819cfbea391f2776e973831cb47a3dad6b566bae9abba288e77bc3a0c851f490"
      }
    },
