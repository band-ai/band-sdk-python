{
  "profile": "band-contract/service/1",
  "kind": "agent",
  "store": {
    "path": "/var/lib/contract-agent/session.sqlite3"
  },
  "engine": {
    "command": [
      "/opt/contract/current/engine/bin/contract-engine"
    ],
    "contract": "/etc/contract-agent/session.band",
    "format": "frontmatter"
  },
  "http": {
    "host": "127.0.0.1",
    "port": 8088,
    "tokens_file": "/etc/contract-agent/tokens.json"
  },
  "poll_interval_ms": 1000,
  "agent": {
    "actor": "agent-1",
    "program_source": "/etc/contract-agent/initial-program.py",
    "artifact_directory": "/var/lib/contract-agent/artifacts",
    "room": {
      "url": "https://room.example.invalid",
      "token_file": "/etc/contract-agent/room.token"
    },
    "provider": {
      "kind": "openai",
      "model": "gpt-4.1-mini-2025-04-14",
      "timeout_ms": 30000,
      "max_output_tokens": 2048,
      "max_request_bytes": 65536,
      "pricing": {
        "input_nano_usd_per_token": 400,
        "cached_input_nano_usd_per_token": 100,
        "output_nano_usd_per_token": 1600,
        "as_of": "2026-10-10"
      }
    },
    "control_actors": {
      "operator-1": [
        "wake",
        "takeover",
        "retry"
      ]
    },
    "max_pending": 16,
    "max_model_calls": 100,
    "max_repairs": 0,
    "max_attempts": 3
  }
}
