[Unit]
Description=Durable contract room authority
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=contract-room
Group=contract-room
StateDirectory=contract-room
StateDirectoryMode=0700
WorkingDirectory=/var/lib/contract-room
ExecStart=/opt/contract/venv/bin/contract-service serve /etc/contract-room/service.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=150
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# The room does not build bubblewrap sandboxes; keep these restrictions here,
# not on contract-agent.service, whose callback setup needs namespaces.
RestrictNamespaces=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
TasksMax=128
LimitNOFILE=1024
LimitCORE=0

[Install]
WantedBy=multi-user.target
