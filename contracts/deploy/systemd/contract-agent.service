[Unit]
Description=Remote contract program and model host
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=contract-agent
Group=contract-agent
StateDirectory=contract-agent
StateDirectoryMode=0700
WorkingDirectory=/var/lib/contract-agent
ExecStart=/opt/contract/venv/bin/contract-service serve /etc/contract-agent/service.json
EnvironmentFile=-/etc/contract-agent/provider.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=150
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=1G
TasksMax=128
LimitNOFILE=1024
LimitCORE=0
# Bubblewrap requires unprivileged user/mount namespaces. Do not add
# RestrictNamespaces=yes or a syscall filter that prevents its setup.
# AF_NETLINK permits bubblewrap to initialize loopback in its new namespace;
# generated code subsequently has every socket syscall denied by seccomp.
# SIGTERM goes to the service first so it can journal bounded child results.
# At TimeoutStopSec, systemd still kills every remaining process in the cgroup.

[Install]
WantedBy=multi-user.target
