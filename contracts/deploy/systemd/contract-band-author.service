[Unit]
Description=Selected Band protocol author
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=contract-author
Group=contract-author
StateDirectory=contract-author
StateDirectoryMode=0700
WorkingDirectory=/var/lib/contract-author
ExecStart=/opt/contract/current-env/bin/contract-band-author --config /etc/contract-author/service.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=200
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1G
TasksMax=128
LimitNOFILE=1024
LimitCORE=0

[Install]
WantedBy=multi-user.target
