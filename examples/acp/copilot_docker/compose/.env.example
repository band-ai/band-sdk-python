# Copilot-entitled GitHub token — the Copilot CLI reads this automatically.
GITHUB_TOKEN=

# Filled by ../sync-band-env.py from agent_config.yaml (copilot_acp_agent).
# Do not invent a second agent key — band-mcp must act as that same identity.
BAND_AGENT_KEY=

# Band platform endpoints (client.py uses these; BAND_BASE_URL for band-mcp
# defaults to BAND_REST_URL in docker-compose.yml).
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# Optional overrides for client.py:
# COPILOT_ACP_HOST=localhost
# COPILOT_ACP_PORT=8080
# COPILOT_ACP_CWD=/
# BAND_MCP_SSE_URL=http://band-mcp:3000/sse
