# Copilot-entitled GitHub token — the Copilot CLI reads this automatically.
GITHUB_TOKEN=

# Same api_key as copilot_acp_agent in agent_config.yaml (host client.py).
# Must be a Band AGENT key (band_a_…), not a user key.
BAND_AGENT_KEY=

# Host directory for per-room workspaces, mounted into the copilot service at
# the same path. Absolute and symlink-free (on macOS use /private/tmp, not /tmp).
COPILOT_WORKSPACES=

# Band platform endpoints (client.py uses these; BAND_BASE_URL for band-mcp
# defaults to BAND_REST_URL in docker-compose.yml).
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# Optional override for client.py:
# BAND_MCP_SSE_URL=http://band-mcp:3000/sse
