{
  "name": "band-cloudflare",
  "main": "src/worker.py",
  "compatibility_flags": ["python_workers"],
  "compatibility_date": "2026-09-29",
  "vars": {
    "BAND_AGENT_ID": "replace-with-your-agent-id",
    "BAND_REST_URL": "https://app.band.ai",
  },
  "secrets": {
    "required": ["BAND_API_KEY", "ANTHROPIC_API_KEY", "BRIDGE_TOKEN"],
  },
  "containers": [
    {
      "name": "band-cloudflare-room",
      "class_name": "Room",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "container/Dockerfile",
          "build_context": "../oneshot",
        },
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room",
      },
    ],
  },
  "exports": {
    "Room": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "band-cloudflare-room",
    },
  },
  "version_metadata": {
    "binding": "VERSION",
  },
}
