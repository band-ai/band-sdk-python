            "mentions": []
          },
          "attachments": [],
          "inserted_at": "2026-08-01T10:05:00Z",
          "updated_at": "2026-08-01T10:05:00Z"
        }
      },
      "sdk": {
        "python": {
          "decision": "accept",
          "normalized": {
            "id": "msg-0002",
            "content": "no mentions here",
            "message_type": "text",
