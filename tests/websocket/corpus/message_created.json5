    // DIVERGENCE case: canonical normalizes `metadata.mentions: null` the same
    // as absent (accept, mentions -> []). band-sdk-python's current
    // MessageMetadata.mentions is `list[Mention] = []` (not Optional) and
    // REJECTS this payload outright today (see sdk.python below). band-sdk-typescript's
    // `.nullish()` already accepts it.
    {
      "name": "metadata_mentions_explicit_null",
      "raw": {
        "id": "msg-0003",
        "content": "explicit null mentions",
        "message_type": "text",
        "sender_type": "User",
        "sender_id": "user-ee05",
        "metadata": {
          "mentions": null
        },
        "attachments": [],
        "inserted_at": "2026-08-01T10:06:00Z",
        "updated_at": "2026-08-01T10:06:00Z"
      },
      "canonical": {
        "decision": "accept",
        "issues": [],
        "normalized": {
          "id": "msg-0003",
          "content": "explicit null mentions",
          "message_type": "text",
          "sender_type": "User",
          "sender_id": "user-ee05",
          "metadata": {
            "mentions": []
          },
          "attachments": [],
          "inserted_at": "2026-08-01T10:06:00Z",
          "updated_at": "2026-08-01T10:06:00Z"
        }
      },
      "sdk": {
        "python": {
          "decision": "reject",
          "normalized": null,
          "errors": [
            {
              "loc": [
                "metadata",
                "mentions"
              ],
              "type": "list_type",
              "msg": "Input should be a valid list"
            }
          ]
        },
        "typescript": {
          "decision": "accept",
          "normalized": {
            "id": "msg-0003",
            "content": "explicit null mentions",
            "message_type": "text",
            "metadata": {
              "mentions": null
            },
            "sender_id": "user-ee05",
            "sender_type": "User",
            "inserted_at": "2026-08-01T10:06:00Z",
            "updated_at": "2026-08-01T10:06:00Z",
            "attachments": []
          },
          "errors": null
        }
      }
    },

    // chat_room_id/thread_id are modeled by one or both SDKs today but the
    // platform's ChatMessagesJSON.data/2 never actually renders them into the
    // message payload (dead/phantom fields) -- included here only to prove they
    // pass through harmlessly if ever present. sender_name: null and
    // metadata.x_custom are genuine unknown-field passthrough cases.
    {
      "name": "unknown_passthrough_and_phantom_fields",
      "raw": {
        "id": "msg-0004",
        "content": "carries fields no SDK models",
        "message_type": "text",
        "sender_type": "User",
        "sender_id": "user-ff06",
        "sender_name": null,
        "chat_room_id": "room-gg07",
        "thread_id": "thread-hh08",
        "metadata": {
          "mentions": [],
          "status": "delivered",
          "x_custom": "keep-me"
        },
        "attachments": [],
        "inserted_at": "2026-08-01T10:07:00Z",
        "updated_at": "2026-08-01T10:07:00Z"
      },
      "canonical": {
        "decision": "accept",
        "issues": [],
        "normalized": {
          "id": "msg-0004",
          "content": "carries fields no SDK models",
          "message_type": "text",
          "sender_type": "User",
          "sender_id": "user-ff06",
          "sender_name": null,
          "chat_room_id": "room-gg07",
          "thread_id": "thread-hh08",
          "metadata": {
            "mentions": [],
            "status": "delivered",
            "x_custom": "keep-me"
          },
          "attachments": [],
          "inserted_at": "2026-08-01T10:07:00Z",
          "updated_at": "2026-08-01T10:07:00Z"
        }
      },
      "sdk": {
        "python": {
          "decision": "accept",
          "normalized": {
            "id": "msg-0004",
            "content": "carries fields no SDK models",
            "message_type": "text",
            "metadata": {
              "mentions": [],
              "status": "delivered",
              "delivery_status": null,
              "x_custom": "keep-me"
            },
            "sender_id": "user-ff06",
            "sender_type": "User",
            "sender_name": null,
            "chat_room_id": "room-gg07",
            "thread_id": "thread-hh08",
            "inserted_at": "2026-08-01T10:07:00Z",
            "updated_at": "2026-08-01T10:07:00Z",
            "attachments": []
          },
          "errors": null
        },
        "typescript": {
          "decision": "accept",
          "normalized": {
            "id": "msg-0004",
            "content": "carries fields no SDK models",
            "message_type": "text",
            "metadata": {
              "mentions": [],
              "status": "delivered",
              "x_custom": "keep-me"
            },
            "sender_id": "user-ff06",
            "sender_type": "User",
            "sender_name": null,
            "chat_room_id": "room-gg07",
            "inserted_at": "2026-08-01T10:07:00Z",
            "updated_at": "2026-08-01T10:07:00Z",
            "thread_id": "thread-hh08",
            "attachments": []
          },
          "errors": null
        }
      }
    },

    // Synthetic malformed input (not observed live). Canonical validates mention
    // *item* shape (object; required string id; optional nullable
    // username/handle/name) — a rule neither Python nor TS's current model has
    // ever lacked (both already require `id: str`/`z.string()` on Mention), but
    // canonical didn't check it until now: `metadata.mentions` was previously
    // validated only as an array, so a non-object element passed straight
    // through to a non-validating hydration step.
    {
      "name": "mention_item_not_an_object",
      "raw": {
        "id": "msg-0005",
        "content": "malformed mention",
        "message_type": "text",
        "sender_type": "User",
        "sender_id": "user-jj10",
        "metadata": {
          "mentions": [1]
        },
        "attachments": [],
        "inserted_at": "2026-08-01T10:09:00Z",
        "updated_at": "2026-08-01T10:09:00Z"
      },
      "canonical": {
        "decision": "reject",
        "issues": [
          {
            "path": "metadata.mentions[0]",
            "code": "wrong_type",
            "message": "`metadata.mentions[0]` must be an object"
          }
        ],
        "normalized": null
      },
      "sdk": {
        "python": {
          "decision": "reject",
          "normalized": null,
          "errors": [
            {
              "loc": [
                "mentions",
                0
              ],
              "type": "model_type",
              "msg": "Input should be a valid dictionary or instance of Mention"
            }
          ]
        },
        "typescript": {
          "decision": "reject",
          "normalized": null,
          "errors": [
            {
              "path": [
                "metadata",
                "mentions",
                0
              ],
              "code": "invalid_type",
              "message": "Expected object, received number"
            }
          ]
        }
      }
    },

    // Synthetic malformed input (not observed live): a mention object missing
    // its required `id`.
    {
      "name": "mention_item_missing_id",
      "raw": {
        "id": "msg-0006",
        "content": "mention with no id",
        "message_type": "text",
        "sender_type": "User",
        "sender_id": "user-kk11",
        "metadata": {
          "mentions": [{"handle": "sage"}]
