              "mentions": [],
              "status": null,
              "delivery_status": null
            },
            "sender_id": "agent-dd04",
            "sender_type": "Agent",
            "sender_name": null,
            "chat_room_id": null,
            "thread_id": null,
            "inserted_at": "2026-08-01T10:05:00Z",
            "updated_at": "2026-08-01T10:05:00Z",
            "attachments": []
          },
          "errors": null
        },
        "typescript": {
          "decision": "accept",
          "normalized": {
            "id": "msg-0002",
            "content": "no mentions here",
            "message_type": "text",
            "metadata": {},
            "sender_id": "agent-dd04",
            "sender_type": "Agent",
            "inserted_at": "2026-08-01T10:05:00Z",
            "updated_at": "2026-08-01T10:05:00Z",
