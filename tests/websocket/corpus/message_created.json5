    // mentions absent -> defaults to []. Compare with the next case: explicit
    // null must normalize identically (absent-vs-null, one rule).
    {
      "name": "metadata_mentions_absent",
      "raw": {
        "id": "msg-0002",
        "content": "no mentions here",
        "message_type": "text",
        "sender_type": "Agent",
        "sender_id": "agent-dd04",
