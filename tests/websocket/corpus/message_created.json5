        "typescript": {
          "decision": "reject",
          "normalized": null,
          "errors": [
            {
              "path": [
                "metadata",
                "mentions",
                0,
                "id"
              ],
              "code": "invalid_type",
              "message": "Required"
            }
          ]
        }
      }
    },

