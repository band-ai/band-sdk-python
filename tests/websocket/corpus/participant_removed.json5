{
  "event_type": "participant_removed",
  "cases": [
    // participant_removed's real wire shape is identical to
    // participant_added's (both flow through
    // format_participant_data_by_record_id / format_from_details on the
    // platform) -- not the bare `{id}` shape either SDK's current schema might
    // suggest. Neither SDK rejects the extra fields today (Python:
    // extra="allow"; TS: .passthrough()), so this is a shape fact, not a live
    // divergence.
    {
      "name": "soft_delete_full_shape_matches_participant_added",
      "raw": {
        "id": "user-pa01",
        "type": "User",
        "name": "Riley Chen",
        "handle": "riley",
        "role": "member",
        "status": "active"
      },
      "canonical": {
        "decision": "accept",
        "issues": [],
        "normalized": {
          "id": "user-pa01",
          "type": "User",
          "name": "Riley Chen",
          "handle": "riley",
          "role": "member",
          "status": "active"
        }
      },
      "sdk": {
        "python": {
          "decision": "accept",
          "normalized": {
            "id": "user-pa01",
            "type": "User",
            "name": "Riley Chen",
            "handle": "riley",
            "role": "member",
            "status": "active"
          },
          "errors": null
        },
        "typescript": {
          "decision": "accept",
          "normalized": {
            "id": "user-pa01",
            "type": "User",
            "name": "Riley Chen",
            "handle": "riley",
            "role": "member",
            "status": "active"
          },
          "errors": null
        }
      }
    },

    // maybe_put_handle omits the key entirely when the platform has no handle --
    // absent, not null.
    {
      "name": "user_participant_no_handle",
      "raw": {
        "id": "user-pa02",
        "type": "User",
        "name": "Sam Ok"
      },
      "canonical": {
        "decision": "accept",
        "issues": [],
        "normalized": {
          "id": "user-pa02",
          "type": "User",
          "name": "Sam Ok"
        }
      },
      "sdk": {
        "python": {
          "decision": "accept",
          "normalized": {
            "id": "user-pa02",
            "type": "User",
            "name": "Sam Ok"
          },
          "errors": null
        },
        "typescript": {
          "decision": "accept",
          "normalized": {
            "id": "user-pa02",
            "type": "User",
            "name": "Sam Ok"
          },
          "errors": null
        }
      }
    },

    // is_remote/is_external normalization: whichever arrives populates the
    // other. The platform only ever sends is_external; is_remote is band-sdk-core's
    // mirrored alias.
    {
      "name": "agent_participant_with_is_external",
      "raw": {
        "id": "agent-pa03",
        "type": "Agent",
        "name": "Sage",
        "description": "Research assistant",
        "is_external": true
      },
      "canonical": {
        "decision": "accept",
        "issues": [],
        "normalized": {
          "id": "agent-pa03",
          "type": "Agent",
          "name": "Sage",
          "description": "Research assistant",
          "is_external": true,
          "is_remote": true
        }
      },
      "sdk": {
        "python": {
          "decision": "accept",
          "normalized": {
            "id": "agent-pa03",
            "type": "Agent",
            "name": "Sage",
            "description": "Research assistant",
            "is_external": true
          },
          "errors": null
        },
        "typescript": {
          "decision": "accept",
          "normalized": {
            "id": "agent-pa03",
            "type": "Agent",
            "name": "Sage",
            "description": "Research assistant",
            "is_external": true
          },
          "errors": null
        }
      }
    },

    {
      "name": "is_remote_only_supplied_mirrors_to_is_external",
      "raw": {
        "id": "agent-pa04",
        "type": "Agent",
        "name": "Nova",
        "is_remote": false
      },
      "canonical": {
        "decision": "accept",
        "issues": [],
        "normalized": {
          "id": "agent-pa04",
          "type": "Agent",
          "name": "Nova",
          "is_remote": false,
          "is_external": false
        }
      },
      "notes": "Defensive case: the platform never actually sends is_remote, but a caller-injected value must still mirror -- this is the alias normalization band-sdk-core's core owns (replacing Python's duplicated _sync_remote_aliases validators).",
      "sdk": {
        "python": {
          "decision": "accept",
          "normalized": {
            "id": "agent-pa04",
            "type": "Agent",
            "name": "Nova",
            "is_remote": false
          },
          "errors": null
        },
        "typescript": {
          "decision": "accept",
          "normalized": {
            "id": "agent-pa04",
            "type": "Agent",
            "name": "Nova",
            "is_remote": false
          },
          "errors": null
        }
      }
    },

    // Unknown keys pass through unchanged.
    {
      "name": "unknown_passthrough_field",
      "raw": {
        "id": "user-pa05",
        "type": "User",
        "name": "Extra",
        "x_custom": "keep-me"
      },
      "canonical": {
        "decision": "accept",
        "issues": [],
        "normalized": {
          "id": "user-pa05",
          "type": "User",
          "name": "Extra",
          "x_custom": "keep-me"
        }
      },
      "sdk": {
        "python": {
          "decision": "accept",
          "normalized": {
            "id": "user-pa05",
            "type": "User",
            "name": "Extra",
            "x_custom": "keep-me"
          },
          "errors": null
        },
        "typescript": {
          "decision": "accept",
          "normalized": {
            "id": "user-pa05",
            "type": "User",
            "name": "Extra",
            "x_custom": "keep-me"
          },
          "errors": null
        }
      }
    },

    {
      "name": "missing_required_name",
      "raw": {
        "id": "user-pa06",
        "type": "User"
      },
      "canonical": {
        "decision": "reject",
        "issues": [
          {
            "path": "name",
            "code": "missing",
            "message": "required field `name` is missing"
          }
        ],
        "normalized": null
      },
      "sdk": {
        "python": {
          "decision": "accept",
          "normalized": {
            "id": "user-pa06",
            "type": "User"
          },
          "errors": null
        },
        "typescript": {
          "decision": "accept",
          "normalized": {
            "id": "user-pa06",
            "type": "User"
          },
          "errors": null
        }
      },
      "notes": "Synthetic malformed input. Canonical promotes name/type to required for participant_removed (matching the real always-present shape, since format_participant_data_by_record_id/3 either fills them via format_from_details/2 or format_minimal_data/1, or skips the push entirely on a nil lookup -- room_participants_channel.ex:134-136,159-161 -- it never pushes a participant_removed missing them). This is stricter than both SDKs current rule, which only requires id for this event -- but since the platform never actually omits name/type when it does push, the tightening carries no live-rejection risk; it only surfaces here, on a payload the platform would never send."
    },

    // format_minimal_data's fallback for a hard-deleted entity the platform can
    // no longer look up.
    {
      "name": "hard_delete_minimal_fallback",
      "raw": {
        "id": "user-pa07",
        "type": "User",
        "name": "Removed Participant"
      },
      "canonical": {
        "decision": "accept",
        "issues": [],
        "normalized": {
          "id": "user-pa07",
          "type": "User",
          "name": "Removed Participant"
        }
      },
      "sdk": {
        "python": {
          "decision": "accept",
          "normalized": {
            "id": "user-pa07",
            "type": "User",
            "name": "Removed Participant"
          },
          "errors": null
        },
        "typescript": {
          "decision": "accept",
          "normalized": {
            "id": "user-pa07",
            "type": "User",
            "name": "Removed Participant"
          },
          "errors": null
        }
      }
    },
  ],
}
