    // DIVERGENCE case: the platform's Agent.ContactsJSON.compact/1 drops
    // from_handle/from_name entirely when the requester entity can't be resolved
    // -- a real, reachable shape. Both SDKs currently declare these fields
    // REQUIRED (band-sdk-python: str, not Optional; band-sdk-typescript: non-nullish
    // string), so both reject this live payload today (see sdk
    // below). Canonical makes them optional.
    {
      "name": "from_handle_and_from_name_absent",
      "raw": {
        "id": "creq-02",
        "message": "Let's connect",
        "status": "pending",
        "inserted_at": "2026-07-11T08:00:00Z"
      },
      "canonical": {
