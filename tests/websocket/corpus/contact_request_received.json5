        }
      },
      "sdk": {
        "python": {
          "decision": "reject",
          "normalized": null,
          "errors": [
            {
              "loc": [
                "from_handle"
              ],
              "type": "missing",
              "msg": "Field required"
            },
            {
              "loc": [
                "from_name"
              ],
              "type": "missing",
              "msg": "Field required"
            }
          ]
        },
        "typescript": {
          "decision": "reject",
          "normalized": null,
          "errors": [
            {
              "path": [
                "from_handle"
              ],
              "code": "invalid_type",
              "message": "Required"
            },
            {
              "path": [
                "from_name"
              ],
              "code": "invalid_type",
              "message": "Required"
            }
          ]
        }
      }
    },

