{
  "event_type": "room_deleted",
  "cases": [
    // The platform's real room_deleted payload is exactly this single field
    // (room_participants_channel.ex).
    {
      "name": "minimal_valid",
      "raw": {
        "id": "room-rd01"
      },
      "canonical": {
        "decision": "accept",
        "issues": [],
        "normalized": {
          "id": "room-rd01"
        }
      },
      "sdk": {
        "python": {
          "decision": "accept",
          "normalized": {
            "id": "room-rd01"
          },
          "errors": null
        },
        "typescript": {
          "decision": "accept",
          "normalized": {
            "id": "room-rd01"
          },
          "errors": null
        }
      }
    },

    // Unknown keys pass through unchanged.
    {
      "name": "unknown_passthrough_field",
      "raw": {
        "id": "room-rd02",
        "x_future_field": "keep-me"
      },
      "canonical": {
        "decision": "accept",
        "issues": [],
        "normalized": {
          "id": "room-rd02",
          "x_future_field": "keep-me"
        }
      },
      "sdk": {
        "python": {
          "decision": "accept",
          "normalized": {
            "id": "room-rd02",
            "x_future_field": "keep-me"
          },
          "errors": null
        },
        "typescript": {
          "decision": "accept",
          "normalized": {
            "id": "room-rd02",
            "x_future_field": "keep-me"
          },
          "errors": null
        }
      }
    },

    // Synthetic malformed input (not observed live) exercising the required-field
    // rejection path.
    {
      "name": "missing_id",
      "raw": {},
      "canonical": {
        "decision": "reject",
        "issues": [
          {
            "path": "id",
            "code": "missing",
            "message": "required field `id` is missing"
          }
        ],
        "normalized": null
      },
      "sdk": {
        "python": {
          "decision": "reject",
          "normalized": null,
          "errors": [
            {
              "loc": [
                "id"
              ],
              "type": "missing",
              "msg": "Field required"
            }
          ]
        },
        "typescript": {
          "decision": "reject",
          "normalized": null,
          "errors": [
            {
              "path": [
                "id"
              ],
              "code": "invalid_type",
              "message": "Required"
            }
          ]
        }
      }
    },
  ],
}
