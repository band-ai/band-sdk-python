{
  "event_type": "participant_added",
  "cases": [
    // role/status ride passthrough on both SDKs today (unmodeled by either) --
    // canonical documents them but does not add a dedicated rule (no verified
    // consumer yet).
    {
      "name": "user_participant_with_handle_and_role",
      "raw": {
        "id": "user-pa01",
        "type": "User",
        "name": "Riley Chen",
        "handle": "riley",
        "role": "member",
        "status": "active"
      },
      "canonical": {
        "decision": "accept",
        "issues": [],
        "normalized": {
          "id": "user-pa01",
          "type": "User",
          "name": "Riley Chen",
          "handle": "riley",
          "role": "member",
          "status": "active"
        }
      },
      "sdk": {
        "python": {
          "decision": "accept",
          "normalized": {
            "id": "user-pa01",
            "name": "Riley Chen",
            "type": "User",
            "handle": "riley",
            "description": null,
            "is_remote": null,
            "is_external": null,
            "role": "member",
            "status": "active"
          },
          "errors": null
        },
        "typescript": {
          "decision": "accept",
          "normalized": {
            "id": "user-pa01",
            "name": "Riley Chen",
            "type": "User",
            "handle": "riley",
            "role": "member",
            "status": "active"
          },
          "errors": null
        }
      }
    },

    // maybe_put_handle omits the key entirely when the platform has no handle --
    // absent, not null.
    {
      "name": "user_participant_no_handle",
      "raw": {
        "id": "user-pa02",
        "type": "User",
        "name": "Sam Ok"
      },
      "canonical": {
        "decision": "accept",
        "issues": [],
        "normalized": {
          "id": "user-pa02",
          "type": "User",
          "name": "Sam Ok"
        }
      },
      "sdk": {
        "python": {
          "decision": "accept",
          "normalized": {
            "id": "user-pa02",
            "name": "Sam Ok",
            "type": "User",
            "handle": null,
            "description": null,
            "is_remote": null,
            "is_external": null
          },
          "errors": null
        },
        "typescript": {
          "decision": "accept",
          "normalized": {
            "id": "user-pa02",
            "name": "Sam Ok",
            "type": "User"
          },
          "errors": null
        }
      }
    },

    // is_remote/is_external normalization: whichever arrives populates the
    // other. The platform only ever sends is_external; is_remote is band-sdk-core's
    // mirrored alias.
    {
      "name": "agent_participant_with_is_external",
      "raw": {
        "id": "agent-pa03",
        "type": "Agent",
        "name": "Sage",
        "description": "Research assistant",
        "is_external": true
      },
      "canonical": {
        "decision": "accept",
        "issues": [],
        "normalized": {
          "id": "agent-pa03",
          "type": "Agent",
          "name": "Sage",
          "description": "Research assistant",
          "is_external": true,
          "is_remote": true
        }
      },
      "sdk": {
        "python": {
          "decision": "accept",
          "normalized": {
            "id": "agent-pa03",
            "name": "Sage",
            "type": "Agent",
            "handle": null,
            "description": "Research assistant",
            "is_remote": true,
            "is_external": true
          },
          "errors": null
        },
        "typescript": {
          "decision": "accept",
          "normalized": {
            "id": "agent-pa03",
            "name": "Sage",
            "type": "Agent",
            "description": "Research assistant",
            "is_external": true
          },
          "errors": null
        }
      }
    },

    {
      "name": "is_remote_only_supplied_mirrors_to_is_external",
      "raw": {
        "id": "agent-pa04",
        "type": "Agent",
        "name": "Nova",
        "is_remote": false
      },
      "canonical": {
        "decision": "accept",
        "issues": [],
        "normalized": {
          "id": "agent-pa04",
          "type": "Agent",
          "name": "Nova",
          "is_remote": false,
          "is_external": false
        }
      },
      "notes": "Defensive case: the platform never actually sends is_remote, but a caller-injected value must still mirror -- this is the alias normalization band-sdk-core's core owns (replacing Python's duplicated _sync_remote_aliases validators).",
      "sdk": {
        "python": {
          "decision": "accept",
          "normalized": {
            "id": "agent-pa04",
            "name": "Nova",
            "type": "Agent",
            "handle": null,
            "description": null,
            "is_remote": false,
            "is_external": false
          },
          "errors": null
        },
        "typescript": {
          "decision": "accept",
          "normalized": {
            "id": "agent-pa04",
            "name": "Nova",
            "type": "Agent",
            "is_remote": false
          },
          "errors": null
        }
      }
    },

    // Unknown keys pass through unchanged.
    {
      "name": "unknown_passthrough_field",
      "raw": {
        "id": "user-pa05",
        "type": "User",
        "name": "Extra",
        "x_custom": "keep-me"
      },
      "canonical": {
        "decision": "accept",
        "issues": [],
        "normalized": {
          "id": "user-pa05",
          "type": "User",
          "name": "Extra",
          "x_custom": "keep-me"
        }
      },
      "sdk": {
        "python": {
          "decision": "accept",
          "normalized": {
            "id": "user-pa05",
            "name": "Extra",
            "type": "User",
            "handle": null,
            "description": null,
            "is_remote": null,
            "is_external": null,
            "x_custom": "keep-me"
          },
          "errors": null
        },
        "typescript": {
          "decision": "accept",
          "normalized": {
            "id": "user-pa05",
            "name": "Extra",
            "type": "User",
            "x_custom": "keep-me"
          },
          "errors": null
        }
      }
    },

    // Synthetic malformed input (not observed live): the platform either fills
    // name/type or skips the push entirely, never sends one without.
    {
      "name": "missing_required_name",
      "raw": {
        "id": "user-pa06",
        "type": "User"
      },
      "canonical": {
        "decision": "reject",
        "issues": [
          {
            "path": "name",
            "code": "missing",
            "message": "required field `name` is missing"
          }
        ],
        "normalized": null
      },
      "sdk": {
        "python": {
          "decision": "reject",
          "normalized": null,
          "errors": [
            {
              "loc": [
                "name"
              ],
              "type": "missing",
              "msg": "Field required"
            }
          ]
        },
        "typescript": {
          "decision": "reject",
          "normalized": null,
          "errors": [
            {
              "path": [
                "name"
              ],
              "code": "invalid_type",
              "message": "Required"
            }
          ]
        }
      }
    },
  ],
}
