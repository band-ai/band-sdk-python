    // DIVERGENCE case: canonical parses retry_after leniently -- a malformed
    // value normalizes to null rather than rejecting the whole event. band-sdk-python's
    // SupersedePayload.retry_after: int | None REJECTS the entire event
    // on a non-coercible string (a Pydantic type error), which today means a
    // real client would drop a supersede notice entirely over one cosmetic
    // field. band-sdk-typescript's hand parser already normalizes any non-number
    // to null, matching canonical.
    {
      "name": "retry_after_malformed_string",
      "raw": {
        "reason": "session.already_connected",
        "message": "This connection has been superseded by a newer session for this agent.",
        "retryable": false,
        "retry_after": "soon",
        "target_socket_id": "agent_socket:agent-sp03",
        "correlation_id": "evict-ZzYyXxWw99=="
      },
      "canonical": {
        "decision": "accept",
        "issues": [],
        "normalized": {
          "reason": "session.already_connected",
          "message": "This connection has been superseded by a newer session for this agent.",
          "retryable": false,
          "retry_after": null,
          "target_socket_id": "agent_socket:agent-sp03",
          "correlation_id": "evict-ZzYyXxWw99=="
        }
      },
      "sdk": {
        "python": {
          "decision": "reject",
          "normalized": null,
          "errors": [
            {
              "loc": [
                "retry_after"
              ],
              "type": "int_parsing",
              "msg": "Input should be a valid integer, unable to parse string as an integer"
            }
          ]
        },
        "typescript": {
          "decision": "accept",
          "normalized": {
            "source": "agent_control",
            "code": "session.already_connected",
            "message": "This connection has been superseded by a newer session for this agent.",
            "retryable": false,
            "retryAfter": null,
            "targetSocketId": "agent_socket:agent-sp03",
            "correlationId": "evict-ZzYyXxWw99=="
          },
          "errors": null
        }
      }
    },

