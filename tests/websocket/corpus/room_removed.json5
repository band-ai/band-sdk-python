              ],
              "code": "invalid_type",
              "message": "Required"
            }
          ]
        }
      }
    },

    {
      "name": "missing_required_timestamp",
      "raw": {
        "id": "room-rr04",
        "title": "Missing updated_at",
        "task_id": null,
        "inserted_at": "2026-07-04T09:00:00Z"
      },
      "canonical": {
        "decision": "reject",
        "issues": [
          {
            "path": "updated_at",
            "code": "missing",
            "message": "required field `updated_at` is missing"
          }
        ],
        "normalized": null
      },
      "notes": "Synthetic malformed input (not observed live) exercising the required-field rejection path.",
      "sdk": {
        "python": {
          "decision": "accept",
          "normalized": {
            "id": "room-rr04",
            "status": null,
