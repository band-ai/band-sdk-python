{
  "event_type": "room_removed",
  "cases": [
    // DIVERGENCE case: canonical accepts this real live room_removed payload.
    // band-sdk-typescript's current roomRemovedPayloadSchema requires
    // status/type/title/removed_at as non-nullable strings -- none of which the
    // platform sends for room_removed -- so TS's current rule REJECTS every live
    // room_removed event (see sdk.typescript below). band-sdk-python's
    // current RoomRemovedPayload only requires `id`, so it already accepts this
    // payload.
    {
      "name": "live_five_field_shape",
      "raw": {
        "id": "room-rr01",
        "title": "Q3 planning",
        "task_id": "task-aa01",
        "inserted_at": "2026-07-01T09:00:00Z",
        "updated_at": "2026-07-15T12:30:00Z"
      },
      "canonical": {
        "decision": "accept",
        "issues": [],
        "normalized": {
          "id": "room-rr01",
          "title": "Q3 planning",
          "task_id": "task-aa01",
          "inserted_at": "2026-07-01T09:00:00Z",
          "updated_at": "2026-07-15T12:30:00Z"
        }
      },
      "sdk": {
        "python": {
          "decision": "accept",
          "normalized": {
            "id": "room-rr01",
            "status": null,
            "type": null,
            "title": "Q3 planning",
            "removed_at": null,
            "task_id": "task-aa01",
            "inserted_at": "2026-07-01T09:00:00Z",
            "updated_at": "2026-07-15T12:30:00Z"
          },
          "errors": null
        },
        "typescript": {
          "decision": "reject",
          "normalized": null,
          "errors": [
            {
              "path": [
                "status"
              ],
              "code": "invalid_type",
              "message": "Required"
            },
            {
              "path": [
                "type"
              ],
              "code": "invalid_type",
              "message": "Required"
            },
            {
              "path": [
                "removed_at"
              ],
              "code": "invalid_type",
              "message": "Required"
            }
          ]
        }
      }
    },

    // An untitled room with no linked task -- both optional fields are
    // legitimately null, not merely absent.
    {
      "name": "task_id_and_title_explicit_null",
      "raw": {
        "id": "room-rr02",
        "title": null,
        "task_id": null,
        "inserted_at": "2026-07-02T09:00:00Z",
        "updated_at": "2026-07-02T09:00:00Z"
      },
      "canonical": {
