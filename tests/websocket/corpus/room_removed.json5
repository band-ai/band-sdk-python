      },
      "sdk": {
        "python": {
          "decision": "accept",
          "normalized": {
            "id": "room-rr02",
            "status": null,
            "type": null,
            "title": null,
            "removed_at": null,
            "task_id": null,
            "inserted_at": "2026-07-02T09:00:00Z",
            "updated_at": "2026-07-02T09:00:00Z"
          },
          "errors": null
        },
        "typescript": {
          "decision": "reject",
          "normalized": null,
          "errors": [
            {
              "path": [
                "status"
              ],
              "code": "invalid_type",
              "message": "Required"
            },
            {
              "path": [
                "type"
              ],
              "code": "invalid_type",
              "message": "Required"
            },
            {
              "path": [
                "title"
              ],
              "code": "invalid_type",
              "message": "Expected string, received null"
            },
            {
              "path": [
                "removed_at"
              ],
              "code": "invalid_type",
              "message": "Required"
            }
          ]
        }
      }
    },

    // Unknown keys pass through unchanged.
    {
      "name": "unknown_passthrough_field",
      "raw": {
        "id": "room-rr03",
        "title": "Has an extra field",
